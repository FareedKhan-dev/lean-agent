        n["✅ <b>check nudge</b><br/>leave one runnable check"]:::plugin --> cr["🔍 <b>critic</b><br/>what could go?"]:::plugin --> d["🏁 <b>done</b>"]:::gold
    end
    s["📏 <b>scored</b><br/>hidden test · meter · guards"]:::lab
    t --> A --> B --> C --> s
    style A fill:#f5fbf8,stroke:#1baf7a
