        direction LR
        a1["🪝 <b>prompt hook</b><br/>adds the level header"]:::plugin --> a2["📜 <b>rules</b><br/>one section of the<br/>system message"]:::plugin --> a3["🗺️ <b>project map</b><br/>what already exists"]:::plugin
